{
  "expo": {
    "name": "zaturi",
    "slug": "zaturi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zaturi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaturi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 이동 경로 주변의 자투리 여행지를 추천하기 위해 위치를 사용합니다."
      }
    },
    "android": {
      "package": "com.zaturi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 이동 경로 주변의 자투리 여행지를 추천하기 위해 위치를 사용합니다."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3786861-8f38-4b58-b544-c0606a38b95b"
      }
    }
  }
}

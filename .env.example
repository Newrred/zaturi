# Public values exposed to the Expo app must use the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Point the Expo app at the local proxy. For Android emulator, use http://10.0.2.2:3000.
EXPO_PUBLIC_ZATURI_ROUTE_PROXY_URL=http://localhost:3000

# Server-only secret. Do not expose this with EXPO_PUBLIC_ and do not commit a real value.
KAKAO_REST_API_KEY=
TOUR_API_SERVICE_KEY=
KAKAO_PROXY_PORT=3000
KAKAO_PROXY_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
KAKAO_ROUTE_CANDIDATE_CORRIDOR_METERS=20000
KAKAO_ROUTE_WAYPOINT_CANDIDATE_LIMIT=8
KAKAO_ROUTE_WAYPOINT_CONCURRENCY=3
TOUR_API_ROUTE_SAMPLE_LIMIT=6
TOUR_API_CANDIDATE_LIMIT=40
TOUR_API_SEARCH_RADIUS_METERS=12000

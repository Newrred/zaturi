{
  "name": "zaturi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "proxy:kakao": "node server/kakao-proxy.mjs",
    "start:proxy": "node server/kakao-proxy.mjs",
    "typecheck": "tsc --noEmit",
    "check:deps": "expo install --check",
    "check:react": "react-doctor --verbose --offline --fail-on none",
    "check:react:strict": "react-doctor --verbose --offline --fail-on error",
    "maestro:version": "maestro --version",
    "test:e2e": "maestro test maestro/flows",
    "test:e2e:live": "maestro test maestro/live-flows",
    "log:new": "node tools/logging/new-work-log.mjs",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "build:android:dev": "npx eas-cli@latest build --profile development --platform android",
    "build:android:preview": "npx eas-cli@latest build --profile preview --platform android",
    "build:ios:dev": "npx eas-cli@latest build --profile development --platform ios",
    "build:android": "npx eas-cli@latest build --profile production --platform android",
    "build:ios": "npx eas-cli@latest build --profile production --platform ios"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.100.11",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "geolib": "^3.3.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-doctor": "^0.2.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
